<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STFU.UI.ViewportStage">
  <Border Background="{DynamicResource StfuBgBrush}"
          BorderBrush="{DynamicResource StfuLineBrush}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Padding="12,10"
              Background="{DynamicResource StfuBgBrush}"
              BorderBrush="{DynamicResource StfuLineSoftBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*">
          <Button Grid.Column="0"
                  Width="34"
                  Height="34"
                  Padding="0"
                  FontSize="16"
                  Content="⚙"
                  Click="OnRendererOptionsClicked" />

          <Border Grid.Column="1"
                  Margin="10,0,0,0"
                  Padding="8,6"
                  Background="{DynamicResource StfuOverlayBrush}"
                  BorderBrush="{DynamicResource StfuLineSoftBrush}"
                  BorderThickness="1"
                  IsVisible="{Binding Renderer.ShowRendererHud}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Viewport.RenderMode}" FontWeight="Bold" />
                <TextBlock Text="{Binding Viewport.SizeLabel}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
                <TextBlock Text="{Binding Debug.GraphHash}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
                <TextBlock Text="{Binding Renderer.StatusSummary}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
              </StackPanel>
              <TextBlock Text="{Binding Renderer.StatusMessage}"
                         Foreground="{DynamicResource StfuMutedBrush}"
                         FontSize="12"
                         IsVisible="{Binding Renderer.HasStatusMessage}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ContentControl x:Name="ViewportHost" />

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,6"
                Background="{DynamicResource StfuOverlayBrush}"
                BorderBrush="{DynamicResource StfuLineSoftBrush}"
                BorderThickness="1">
          <TextBlock Text="{Binding Camera.CompactLabel}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
        </Border>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="12"
                Padding="8,6"
                Background="{DynamicResource StfuOverlayBrush}"
                BorderBrush="{DynamicResource StfuLineSoftBrush}"
                BorderThickness="1">
          <TextBlock Text="{Binding LastCommandText}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
