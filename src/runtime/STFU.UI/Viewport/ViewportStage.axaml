<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STFU.UI.ViewportStage">
  <Border Background="{DynamicResource StfuBgBrush}"
          BorderBrush="{DynamicResource StfuLineBrush}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid>
      <ContentControl x:Name="ViewportHost" />

      <Border HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="12"
              Padding="8,6"
              Background="{DynamicResource StfuOverlayBrush}"
              BorderBrush="{DynamicResource StfuLineSoftBrush}"
              BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Viewport.RenderMode}" FontWeight="Bold" />
          <TextBlock Text="{Binding Viewport.SizeLabel}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
          <TextBlock Text="{Binding Debug.GraphHash}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
        </StackPanel>
      </Border>

      <Border HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              Margin="12"
              Padding="8,6"
              Background="{DynamicResource StfuOverlayBrush}"
              BorderBrush="{DynamicResource StfuLineSoftBrush}"
              BorderThickness="1">
        <TextBlock Text="{Binding Camera.CompactLabel}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
      </Border>

      <Border HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="12"
              Padding="8,6"
              Background="{DynamicResource StfuOverlayBrush}"
              BorderBrush="{DynamicResource StfuLineSoftBrush}"
              BorderThickness="1">
        <TextBlock Text="{Binding LastCommandText}" Foreground="{DynamicResource StfuMutedBrush}" FontSize="12" />
      </Border>
    </Grid>
  </Border>
</UserControl>
