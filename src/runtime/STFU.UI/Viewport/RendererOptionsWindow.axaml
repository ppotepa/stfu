<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="STFU.UI.RendererOptionsWindow"
        Width="480"
        Height="540"
        MinWidth="440"
        MinHeight="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Renderer Options"
        Background="{DynamicResource StfuBgBrush}">
  <Border Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="18">
        <TextBlock Text="Renderer Options"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <StackPanel Spacing="8">
          <TextBlock Text="Backend" FontWeight="SemiBold" />
          <ComboBox x:Name="BackendCombo"
                    SelectionChanged="OnBackendSelectionChanged">
            <ComboBoxItem Content="Auto" />
            <ComboBoxItem Content="Full CPU" />
            <ComboBoxItem Content="CPU + GPU" />
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Graphics API" FontWeight="SemiBold" />
          <RadioButton x:Name="ApiAutoButton"
                       GroupName="RendererApi"
                       Content="Auto"
                       Click="OnApiChecked" />
          <RadioButton x:Name="ApiDirectX11Button"
                       GroupName="RendererApi"
                       Content="DirectX 11"
                       Click="OnApiChecked" />
          <RadioButton Content="Vulkan (Not implemented)"
                       IsEnabled="False" />
          <RadioButton Content="OpenGL (Not implemented)"
                       IsEnabled="False" />
          <RadioButton Content="Direct3D 12 (Not implemented)"
                       IsEnabled="False" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Presentation" FontWeight="SemiBold" />
          <ComboBox x:Name="PresentationCombo"
                    SelectionChanged="OnPresentationSelectionChanged">
            <ComboBoxItem Content="Auto" />
            <ComboBoxItem Content="Direct GPU" />
            <ComboBoxItem Content="GPU Readback" />
          </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
          <CheckBox x:Name="ShowHudCheckBox"
                    Content="Show renderer HUD"
                    IsChecked="{Binding ShowRendererHud}" />
          <CheckBox x:Name="GpuTimingsCheckBox"
                    Content="Enable GPU timings"
                    IsChecked="{Binding EnableGpuTimings}" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Runtime Info" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Backend" Foreground="{DynamicResource StfuMutedBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EffectiveBackend}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="API" Foreground="{DynamicResource StfuMutedBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EffectiveApi}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Presentation" Foreground="{DynamicResource StfuMutedBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EffectivePresentation}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Adapter" Foreground="{DynamicResource StfuMutedBrush}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AdapterName}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" Foreground="{DynamicResource StfuMutedBrush}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button Content="Close"
                  Click="OnCloseClicked" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
