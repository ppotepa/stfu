<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STFU.UI.Inspector.Load.Widgets.ImportOptionsWidget">
  <Border Classes="load-card">
    <StackPanel Spacing="8">
      <TextBlock Text="IMPORT OPTIONS" Classes="load-section-title" />
      <CheckBox Content="Normalize size" IsChecked="{Binding Assets.NormalizeSize, Mode=TwoWay}" />
      <CheckBox Content="Center pivot" IsChecked="{Binding Assets.CenterPivot, Mode=TwoWay}" />
      <CheckBox Content="Load animations" IsChecked="{Binding Assets.LoadAnimations, Mode=TwoWay}" />
    </StackPanel>
  </Border>
</UserControl>
