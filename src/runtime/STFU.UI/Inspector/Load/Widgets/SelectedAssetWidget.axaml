<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STFU.UI.Inspector.Load.Widgets.SelectedAssetWidget">
  <Border Classes="load-card">
    <StackPanel Spacing="8">
      <TextBlock Text="SELECTED ASSET" Classes="load-section-title" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
        <TextBlock Text="Name" Foreground="{DynamicResource StfuMutedBrush}" FontSize="11" />
        <TextBlock Grid.Column="1" Text="{Binding Assets.SelectedAssetName}" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="Path" Foreground="{DynamicResource StfuMutedBrush}" FontSize="11" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Assets.SelectedAssetPath}" TextWrapping="Wrap" FontSize="11" />
        <TextBlock Grid.Row="2" Text="Format" Foreground="{DynamicResource StfuMutedBrush}" FontSize="11" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Assets.SelectedAssetFormat}" />
        <TextBlock Grid.Row="3" Text="Status" Foreground="{DynamicResource StfuMutedBrush}" FontSize="11" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Assets.SelectedAssetStatus}" />
        <TextBlock Grid.Row="4" Text="Meta" Foreground="{DynamicResource StfuMutedBrush}" FontSize="11" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Assets.SelectedAssetMetadata}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
