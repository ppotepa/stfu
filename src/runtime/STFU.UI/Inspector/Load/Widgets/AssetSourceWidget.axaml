<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="STFU.UI.Inspector.Load.Widgets.AssetSourceWidget">
  <Border Classes="load-card">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="ASSET SOURCE" Classes="load-section-title" />
        <TextBlock Grid.Column="1"
                   x:Name="SourceStatusText"
                   Foreground="{DynamicResource StfuMutedBrush}"
                   FontSize="11" />
      </Grid>
      <StackPanel x:Name="SourceOptionsHost"
                  Orientation="Horizontal"
                  Spacing="0" />
    </StackPanel>
  </Border>
</UserControl>
