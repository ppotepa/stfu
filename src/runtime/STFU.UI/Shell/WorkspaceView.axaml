<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:STFU.UI"
             x:Class="STFU.UI.WorkspaceView">
  <Grid RowDefinitions="48,*" Background="{DynamicResource StfuBgBrush}">
    <ui:TopBarView Grid.Row="0" />
    <Grid Grid.Row="1"
          ColumnDefinitions="*,480"
          Margin="16"
          ColumnSpacing="16">
      <ui:ViewportStage Grid.Column="0" x:Name="ViewportStage" />
      <ui:InspectorView Grid.Column="1" />
    </Grid>
  </Grid>
</UserControl>
