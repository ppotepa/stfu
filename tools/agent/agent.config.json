{
  "schema": "agent.config.v1",
  "defaultSolution": "STFU.slnx",
  "defaultFormat": "table",
  "cacheDirectory": ".agents/cache",
  "generatedPatterns": [
    "**/obj/**",
    "**/bin/**",
    "**/*.g.cs",
    "**/*.Designer.cs",
    "**/Generated/**"
  ],
  "alwaysExcludePatterns": [
    "**/bin/**",
    "**/obj/**",
    "**/.git/**",
    "**/.vs/**",
    ".agents/**",
    ".logs/**",
    "artifacts/**",
    "logs/**",
    "test-results/**",
    "TestResults/**",
    "tools/parity/test-results/**",
    "release/**",
    "concat.txt",
    "concat.zip",
    "**/*.trx",
    "**/*.coverage",
    "**/*.coveragexml"
  ],
  "defaultConcatProfile": "source",
  "concatProfiles": {
    "source": {
      "include": [
        "src/**",
        "STFU.sln",
        "STFU.slnx",
        "*.sln",
        "*.slnx",
        "*.csproj",
        "Directory.Build.*",
        "Directory.Packages.props",
        "global.json",
        "NuGet.config",
        ".gitignore",
        "README.md",
        "docs/*BRIEF*.md",
        "docs/AGENT_CONTEXT.md"
      ],
      "exclude": [
        "docs/NPR_SUPPLEMENT_IMPL.md"
      ]
    }
  },
  "includeScopes": {
    "tools": [ "tools/**" ],
    "maquettes": [ "maquettes/**" ],
    "third_party": [ "third_party/**" ],
    "third-party": [ "third_party/**" ],
    "vendor": [ "third_party/**" ],
    "assets": [ "assets/**" ],
    "docs": [ "docs/**" ],
    "root": [
      "*.sln",
      "*.slnx",
      "*.csproj",
      "Directory.Build.*",
      "Directory.Packages.props",
      "global.json",
      "NuGet.config",
      ".gitignore",
      "README.md"
    ]
  },
  "excludePatterns": [
    "**/bin/**",
    "**/obj/**",
    "**/.git/**",
    "**/.vs/**"
  ],
  "scopes": {
    "all": {
      "include": [ "src/**/*.cs" ],
      "exclude": [ "**/bin/**", "**/obj/**" ]
    },
    "runtime": {
      "projects": [ "src/runtime/**/*.csproj" ]
    },
    "tests": {
      "projects": [ "tests/**/*.csproj", "src/**/*Tests*.csproj" ]
    },
    "ui": {
      "projects": [ "*UI*", "*Bridge*", "*App*" ]
    },
    "import": {
      "projects": [ "*Import*" ]
    },
    "render": {
      "projects": [ "*Render*", "*Rendering*" ]
    },
    "native": {
      "include": [ "native/**/*", "src/native/**/*" ]
    }
  },
  "hotspotRules": {
    "default": [
      "alloc-in-loop",
      "linq-in-loop",
      "sync-wait",
      "large-struct-copy",
      "reflection",
      "pinvoke",
      "unsafe",
      "boxing",
      "string-concat-loop"
    ]
  },
  "presets": {
    "stfu": {
      "fbx-mesh-regression": "tools/agent/presets/stfu/fbx-mesh-regression.ps1",
      "npr-parity-audit": "tools/agent/presets/stfu/npr-parity-audit.ps1",
      "gpu-readback-audit": "tools/agent/presets/stfu/gpu-readback-audit.ps1"
    }
  }
}
